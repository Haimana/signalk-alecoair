{
  "openapi": "3.0.3",
  "info": {
    "title": "ALECOAIR D13 Traditio",
    "version": "1.0.0",
    "description": "Native Signal K control and monitoring for the ALECOAIR D13 Traditio over Tuya LAN. No Node-RED."
  },
  "servers": [
    { "url": "/plugins/signalk-alecoair-d13" }
  ],
  "paths": {
    "/state": {
      "get": {
        "summary": "Current device state",
        "responses": {
          "200": { "description": "D13 state plus setup status" }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Connection health",
        "responses": {
          "200": { "description": "OK / disconnected" }
        }
      }
    },
    "/setup": {
      "get": {
        "summary": "Smart Life setup status and device list",
        "responses": {
          "200": { "description": "Link state, adopted device, public device list" }
        }
      }
    },
    "/smartlife/qr": {
      "post": {
        "summary": "Start Smart Life QR login",
        "responses": {
          "200": { "description": "QR payload" }
        }
      }
    },
    "/smartlife/poll": {
      "post": {
        "summary": "Poll QR login and persist the account plus device keys",
        "responses": {
          "200": { "description": "Pending, linked, or adopted" }
        }
      }
    },
    "/adopt": {
      "post": {
        "summary": "Use a device from the stored Smart Life list",
        "responses": {
          "200": { "description": "Device stored and plugin restarted" }
        }
      }
    },
    "/command": {
      "post": {
        "summary": "Send a command (power, mode, targetHumidity, fan, childLock, timerHours, sleep, insideDry)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": { "description": "State after the command" },
          "400": { "description": "Invalid command" }
        }
      }
    }
  }
}
