{
  "name": "signalk-alecoair",
  "version": "0.0.5",
  "description": "Signal K plugin and WebApp for AlecoAir Wi-Fi dehumidifiers over Tuya LAN: several units, model profiles, setup in Signal K Admin, Node.js only, no cloud or Node-RED in the control path.",
  "main": "plugin/index.js",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-plugin-configurator",
    "signalk-category-hardware",
    "alecoair",
    "dehumidifier",
    "tuya"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "AlecoAir",
    "appIcon": "./icon.svg",
    "screenshots": [
      "./docs/screenshots/webapp.png",
      "./docs/screenshots/admin-setup.png",
      "./docs/screenshots/admin-external.png"
    ]
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Seb D",
  "license": "Apache-2.0",
  "dependencies": {
    "tuyapi": "^7.7.1"
  },
  "files": [
    "plugin",
    "public",
    "openapi.json",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haimana/signalk-alecoair.git"
  },
  "bugs": {
    "url": "https://github.com/Haimana/signalk-alecoair/issues"
  },
